{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drift",
  "version": "0.1.3",
  "identifier": "com.drift.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "drift",
        "width": 1920,
        "height": 1080,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "wickedlovesunturned",
    "homepage": "https://github.com/wickedlovesunturned/drift",
    "copyright": "Copyright © 2026 drift contributors",
    "category": "Music",
    "shortDescription": "Navidrome desktop client",
    "longDescription": "drift is an open-source desktop client for Navidrome and other Subsonic-compatible servers, with Last.fm scrobbling, synchronized lyrics, and Discord Rich Presence.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "installer/installer.ico",
        "uninstallerIcon": "installer/installer.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
